# ---- Browser (Vite exposes VITE_* to the bundle; this key is public by design) ----
# Map Tiles API enabled. Restrict it by HTTP referrer in Google Cloud console.
VITE_GOOGLE_MAPS_KEY=

# ---- Proxy only (scripts/proxy.mjs). Never prefix these with VITE_. ----
# Routes API enabled. Restrict by API (Routes only); it is never shipped to the browser.
GOOGLE_ROUTES_KEY=
OPENAI_API_KEY=
# Scout and Critic (reasoning; JSON replies need >= 2000 output tokens) and Narrator (fast, low reasoning).
LLM_MODEL_SCOUT=
LLM_MODEL_CRITIC=
LLM_MODEL_NARRATOR=
# ElevenLabs TTS (proxy only). The key is enough; voice id defaults to George.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# The goose's voice: a voice on the account by name or id. Default Gigi, ElevenLabs' light American animation voice, pitched up by the flight.
# (`duck` or `library:<name>` would borrow a cartoon duck from the voice library instead; GET /api/voices/ducks lists them.)
ELEVENLABS_GOOSE_VOICE=Gigi
# The stand-in voice is asked for this slow and played faster by the inverse, which lifts it without hurrying it.
ELEVENLABS_GOOSE_SPEED=0.82
ELEVENLABS_MODEL=eleven_v3
# Leave empty. The proxy asks your account which models the key can actually
# use and gives the guide's live answers the most expressive of them: v3 where
# an account has it, since it performs the [warmly] audio tags, and otherwise
# eleven_multilingual_v2, whose feeling comes from the voice settings the
# chosen mood implies. Set this only to overrule that choice; a model the
# account cannot use is safe either way, as the server notices and falls back.
ELEVENLABS_MODEL_EXPRESSIVE=
PORT=8787

# ---- Error reporting (Sentry). Both optional: with no DSN every report is a no-op. ----
# Browser DSN (public by design; Sentry DSNs are safe to ship). Create a "React" project.
# Enable Errors, Tracing, Session Replay, Logs, Profiling, and User Feedback on that project.
VITE_SENTRY_DSN=
# Fraction of page loads traced / replayed / profiled (default 1 while judging).
VITE_SENTRY_TRACES=
VITE_SENTRY_REPLAY=
VITE_SENTRY_PROFILES=
# Proxy DSN: a separate "Node" project keeps server and browser issues apart.
# Enable Tracing, Logs, and (in Sentry: Alerts → Uptime) a monitor on GET /api/health.
SENTRY_DSN=
SENTRY_ENV=development

# Saved trips. With a MongoDB connection string (Atlas free tier is enough) trips are kept in the
# cloud and open from any device; without it they are kept in the proxy's memory and lost on restart.
MONGODB_URI=
# MONGODB_DB=orion
