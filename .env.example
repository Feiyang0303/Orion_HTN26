# ---- Browser (Vite exposes VITE_* to the bundle; this key is public by design) ----
# Map Tiles API enabled. Restrict it by HTTP referrer in Google Cloud console.
VITE_GOOGLE_TILES_KEY=

# ---- Proxy only (scripts/proxy.mjs). Never prefix these with VITE_. ----
# Routes API enabled. Restrict by API (Routes only); it is never shipped to the browser.
GOOGLE_ROUTES_KEY=
OPENAI_API_KEY=
# Scout and Critic (reasoning; JSON replies need >= 2000 output tokens) and Narrator (fast, low reasoning).
LLM_MODEL_SCOUT=
LLM_MODEL_CRITIC=
LLM_MODEL_NARRATOR=
# ElevenLabs TTS (proxy only). Voice id is from your ElevenLabs voice library.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
PORT=8787
