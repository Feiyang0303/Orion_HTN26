{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": { "env": { "NODEJS_HELPERS": "0" } },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?__path=$1" },
    { "source": "/vr", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Document-Policy", "value": "js-profiling" }] }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 300 }
  }
}
